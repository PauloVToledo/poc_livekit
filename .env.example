LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVEN_API_KEY=

DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
OPENAI_MODEL=gpt-4.1-mini
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_VOICE_ID=

# Runway: solo WebRTC. Completar exactamente uno de AVATAR_ID / PRESET_ID.
RUNWAY_ENABLED=false
RUNWAYML_API_SECRET=
RUNWAY_AVATAR_ID=
RUNWAY_PRESET_ID=
# Techo de seguridad: incluye arranque, 5 minutos y la interacción final.
# El controlador cierra el avatar tras reproducir la despedida.
RUNWAY_MAX_DURATION_SECONDS=900

# Introducción → 5 minutos → terminar turno → pregunta final → respuesta → despedida.
INTERVIEW_AUTO_START=true
INTERVIEW_DURATION_SECONDS=300
INTERVIEW_AUTO_CLOSE=true
